# Caddyfile for the vglist frontend image (frontend/Dockerfile), which serves
# the Vite build from /app/dist.
#
# Beyond static file serving and the SPA fallback, the main addition is the
# `header` block below, which adds a full Content-Security-Policy plus other
# hardening headers.

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		# Trust the platform's edge proxy so request logs get the real client IP.
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	handle /health {
		respond 200
	}

	# Same-origin CSP report sink (see report-uri below). Reports go to
	# Sentry when CSP_REPORT_URI is set; this just keeps the directive
	# valid without it and stops reports falling through to the SPA.
	handle /csp-report {
		respond 204
	}

	header {
		# Baseline hardening.
		X-Content-Type-Options "nosniff"
		-Server

		# Additional hardening.
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# Content Security Policy (enforced, not report-only).
		#
		# - script-src 'self': Vite emits hashed ES module bundles with no
		#   inline <script> tags. challenges.cloudflare.com serves the
		#   Turnstile script for the sign-up form's bot check, and frame-src
		#   allows the challenge iframe it renders.
		# - style-src 'self' 'unsafe-inline' + style-src-attr 'unsafe-inline':
		#   Vue's :style bindings render inline style="" attributes at runtime.
		#   'unsafe-inline' on style-src-attr covers those. style-src also
		#   has 'unsafe-inline' for now, which the report-only policy below
		#   removes. We never render untrusted HTML, so this is low-risk.
		# - img-src includes the Cloudflare R2 custom domain that serves game
		#   covers and user avatars.
		# - connect-src uses {$API_ORIGIN} (set per-environment on the service)
		#   so the API origin can change per
		#   environment without editing this file. *.sentry.io is whitelisted
		#   preemptively for the browser Sentry SDK envelope endpoint.
		# - frame-ancestors 'none' replaces the old X-Frame-Options: DENY
		#   (only works as a real header, not via <meta>).
		# - upgrade-insecure-requests auto-upgrades any stray http:// asset
		#   URLs (e.g. from older cached data) to https://.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: https://files.vglist.co; font-src 'self' data:; connect-src 'self' {$API_ORIGIN:https://api.vglist.co} https://*.sentry.io; upgrade-insecure-requests"

		# Stricter candidate policy, report-only while we check it breaks
		# nothing. Once it's quiet, it replaces the enforced policy above.
		# Differences from the enforced policy:
		#
		# - style-src drops 'unsafe-inline' (which style-src-attr would
		#   otherwise fall back to as well, allowing injected <style>
		#   elements). Vite emits CSS as <link>ed files; the only inline
		#   <style> is index.html's dark-mode background, allowed by hash.
		#   Vite minifies that block, so the hash is of the BUILT content:
		#   after editing it, rebuild and recompute with
		#     sed -n 's:.*<style>\(.*\)</style>.*:\1:p' frontend/dist/index.html \
		#       | tr -d '\n' | openssl dgst -sha256 -binary | openssl base64
		#   The Docker workflow fails if the hash doesn't match.
		#   style-src-attr keeps 'unsafe-inline' for Vue :style bindings.
		# - base-uri 'none': the app never uses <base>.
		# - worker-src 'none': no web workers or service workers.
		# - connect-src allows only the Sentry ingest origin from the DSN
		#   (SENTRY_INGEST_ORIGIN, e.g. https://o123.ingest.us.sentry.io),
		#   falling back to any sentry.io subdomain when unset.
		# - manifest-src 'self' is explicit for site.webmanifest.
		# - report-uri sends violations to Sentry's security endpoint
		#   (CSP_REPORT_URI, from Sentry's project settings under Security
		#   Headers). /csp-report is a same-origin sink, handled below, so
		#   the directive stays valid when CSP_REPORT_URI is empty.
		# - No upgrade-insecure-requests: browsers ignore it (with a console
		#   warning) in a report-only policy. Add it back when promoting.
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'sha256-WFDtyQ8I111UJiy9VSzAQXXjXb4NUiZ9nrPyP63GEvU='; style-src-attr 'unsafe-inline'; img-src 'self' data: https://files.vglist.co; font-src 'self' data:; connect-src 'self' {$API_ORIGIN:https://api.vglist.co} {$SENTRY_INGEST_ORIGIN:https://*.sentry.io}; worker-src 'none'; manifest-src 'self'; report-uri /csp-report {$CSP_REPORT_URI}"
	}

	encode {
		gzip
		zstd
	}

	# Link-preview crawlers don't run JavaScript, so the SPA's index.html
	# gives them nothing to unfurl. Send their game page requests to the
	# API, which renders Open Graph tags and a Discord component embed (see
	# EmbedsController). Only bare /games/<id> paths match, not /games/new or
	# /games/<id>/edit. Crawlers not listed here just get the SPA.
	#
	# iMessage identifies as "facebookexternalhit ... Twitterbot", Mastodon
	# as "http.rb/... (Mastodon/...)", and Bluesky as "Bluesky Cardyb/...".
	@link_preview_bot {
		path_regexp game_page ^/games/(\d+)/?$
		header_regexp User-Agent (?i)(discordbot|twitterbot|facebookexternalhit|facebot|slackbot|bluesky|cardyb|telegrambot|whatsapp|linkedinbot|mastodon|redditbot|skypeuripreview|embedly|iframely|vkshare|pinterest|tumblr|googlechat)
	}

	# `handle` blocks are mutually exclusive (the matcher-less one below is
	# the fallback), so this must stay in its own block. Otherwise
	# `try_files` below, which Caddy runs before `reverse_proxy`, would
	# rewrite the request to /index.html first.
	handle @link_preview_bot {
		rewrite * /embeds/games/{re.game_page.1}
		reverse_proxy {$API_ORIGIN:https://api.vglist.co} {
			# App Platform routes by hostname, so send the API's, not vglist.co.
			header_up Host {upstream_hostport}
		}
	}

	# Password managers send users here to change their password. Redirect
	# to the account settings page; signed-out users go through sign-in
	# first because the route requires auth.
	handle /.well-known/change-password {
		redir /settings/account 302
	}

	# W3C Passkey Endpoints: tells password managers where users add and
	# manage passkeys (the Passkeys card in account settings). Passkeys are
	# bound to vglist.co, so the URLs are on the production origin.
	handle /.well-known/passkey-endpoints {
		header Content-Type application/json
		respond `{"enroll":"https://vglist.co/settings/account","manage":"https://vglist.co/settings/account"}` 200
	}

	# Every other /.well-known/ path (Chrome DevTools' appspecific JSON,
	# crawler probes, etc.) gets a real 404 instead of the SPA's HTML 200.
	handle /.well-known/* {
		respond 404
	}

	# Source maps go to Sentry and are deleted in the build (see
	# frontend/Dockerfile). Never serve one, even if a build leaves one behind.
	@source_map path *.map
	handle @source_map {
		header Cache-Control "no-store"
		respond 404
	}

	handle {
		root * /app/dist

		# `route` runs these in the order written, so the Cache-Control
		# matchers below see the path after try_files has rewritten it.
		route {
			# SPA fallback — unknown paths serve index.html so Vue Router can
			# handle client-side routing.
			#
			# Not for /assets/*: a missing hashed chunk means a tab is still
			# running the previous deploy. Answering with index.html (200,
			# text/html) made the module import fail on its MIME type instead,
			# and a real 404 is the honest answer. Either way the router sees a
			# failed import and reloads the page (src/utils/chunk-reload.ts).
			# This is what `try_files` expands to, which takes no matcher.
			@spa_route {
				not path /assets/*
				file {path} {path}.html {path}/index.html /index.html
			}
			rewrite @spa_route {file_match.relative}

			# Cache-Control. Without it, browsers fall back to heuristic
			# caching and keep revalidating the hashed bundles.
			#
			# - Vite's /assets/* files have a content hash in their name, so
			#   a changed file always gets a new URL: cache them forever.
			# - Unhashed files copied from ../public (favicons, manifest,
			#   opensearch.xml, robots.txt) keep their URL across deploys,
			#   so cache them briefly.
			# - Everything else is HTML (index.html, the SPA fallback for
			#   deep routes, the error pages), which must be revalidated so a
			#   deploy picks up the new bundle names. ETag/Last-Modified keep
			#   that a cheap 304.
			# - A missing /assets/* file 404s with no-store. During a rolling
			#   deploy an old container can briefly be asked for a new chunk,
			#   and a 404 cached for a year would break that URL for good.
			@hashed_asset {
				path /assets/*
				file
			}
			@missing_asset {
				path /assets/*
				not file
			}
			@public_static {
				not path /assets/*
				path *.png *.jpg *.svg *.ico *.webmanifest *.xml *.txt
			}
			@html not path /assets/* *.png *.jpg *.svg *.ico *.webmanifest *.xml *.txt
			header @hashed_asset Cache-Control "public, max-age=31536000, immutable"
			header @missing_asset Cache-Control "no-store"
			header @public_static Cache-Control "public, max-age=86400"
			header @html Cache-Control "no-cache"

			file_server {
				hide .git
				hide .env*
			}
		}
	}
}
