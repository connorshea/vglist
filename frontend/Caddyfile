# Caddyfile for the vglist frontend image (frontend/Dockerfile), which serves
# the Vite build from /app/dist.
#
# Beyond static file serving and the SPA fallback, the main addition is the
# `header` block below, which adds a full Content-Security-Policy plus other
# hardening headers.

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		# Trust the platform's edge proxy so request logs get the real client IP.
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	handle /health {
		respond 200
	}

	header {
		# Baseline hardening.
		X-Content-Type-Options "nosniff"
		-Server

		# Additional hardening.
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# Content Security Policy (enforced, not report-only).
		#
		# - script-src 'self': Vite emits hashed ES module bundles with no
		#   inline <script> tags. challenges.cloudflare.com serves the
		#   Turnstile script for the sign-up form's bot check, and frame-src
		#   allows the challenge iframe it renders.
		# - style-src 'self' 'unsafe-inline' + style-src-attr 'unsafe-inline':
		#   Vue's :style bindings render inline style="" attributes at runtime.
		#   'unsafe-inline' on style-src-attr covers those; style-src stays
		#   strict apart from Vite's build-time CSS injection which also needs
		#   it. We never render untrusted HTML, so this is low-risk.
		# - img-src includes the Cloudflare R2 custom domain that serves game
		#   covers and user avatars.
		# - connect-src uses {$API_ORIGIN} (set per-environment on the service)
		#   so the API origin can change per
		#   environment without editing this file. *.sentry.io is whitelisted
		#   preemptively for the browser Sentry SDK envelope endpoint.
		# - frame-ancestors 'none' replaces the old X-Frame-Options: DENY
		#   (only works as a real header, not via <meta>).
		# - upgrade-insecure-requests auto-upgrades any stray http:// asset
		#   URLs (e.g. from older cached data) to https://.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: https://files.vglist.co; font-src 'self' data:; connect-src 'self' {$API_ORIGIN:https://api.vglist.co} https://*.sentry.io; upgrade-insecure-requests"
	}

	encode {
		gzip
		zstd
	}

	# Link-preview crawlers don't run JavaScript, so the SPA's index.html
	# gives them nothing to unfurl. Send their game page requests to the
	# API, which renders Open Graph tags and a Discord component embed (see
	# EmbedsController). Only bare /games/<id> paths match, not /games/new or
	# /games/<id>/edit. Crawlers not listed here just get the SPA.
	#
	# iMessage identifies as "facebookexternalhit ... Twitterbot", Mastodon
	# as "http.rb/... (Mastodon/...)", and Bluesky as "Bluesky Cardyb/...".
	@link_preview_bot {
		path_regexp game_page ^/games/(\d+)/?$
		header_regexp User-Agent (?i)(discordbot|twitterbot|facebookexternalhit|facebot|slackbot|bluesky|cardyb|telegrambot|whatsapp|linkedinbot|mastodon|redditbot|skypeuripreview|embedly|iframely|vkshare|pinterest|tumblr|googlechat)
	}

	# `handle` blocks are mutually exclusive (the matcher-less one below is
	# the fallback), so this must stay in its own block. Otherwise
	# `try_files` below, which Caddy runs before `reverse_proxy`, would
	# rewrite the request to /index.html first.
	handle @link_preview_bot {
		rewrite * /embeds/games/{re.game_page.1}
		reverse_proxy {$API_ORIGIN:https://api.vglist.co} {
			# App Platform routes by hostname, so send the API's, not vglist.co.
			header_up Host {upstream_hostport}
		}
	}

	# Password managers send users here to change their password. Redirect
	# to the account settings page; signed-out users go through sign-in
	# first because the route requires auth.
	handle /.well-known/change-password {
		redir /settings/account 302
	}

	# Every other /.well-known/ path (Chrome DevTools' appspecific JSON,
	# crawler probes, etc.) gets a real 404 instead of the SPA's HTML 200.
	handle /.well-known/* {
		respond 404
	}

	handle {
		root * /app/dist

		file_server {
			hide .git
			hide .env*
		}

		# SPA fallback — unknown paths serve index.html so Vue Router can
		# handle client-side routing.
		try_files {path} {path}.html {path}/index.html /index.html
	}
}
