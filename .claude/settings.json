{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edited-file.sh",
            "timeout": 150
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "managing-dependencies@managing-dependencies": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "frontend/node_modules/ts-log/.vscode/settings.json",
        "frontend/node_modules/ts-log/.vscode/launch.json"
      ]
    },
    "enableWeakerNetworkIsolation": true
  }
}
